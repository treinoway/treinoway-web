# Variables of the native app build (`npm run build:app`, Vite mode "app").
#
# Mode "app" never loads .env.production: that file ships with EMPTY Firebase values, and the empty
# values override .env in mode production. That was the cause of the blank screen in the spike
# (getAuth threw auth/invalid-api-key before React mounted). Pass these through the process
# environment (CI) or a local, git-ignored .env.app.local. Variables set in the process always win.

# API (release builds must be https://, enforced by `npm run check:native-release`)
VITE_API_BASE_URL=https://api.example.com

# Native Google sign-in. The backend accepts ONE audience, so the web client ID is used everywhere.
VITE_GOOGLE_WEB_CLIENT_ID=
# iOS only: the iOS OAuth client ID (also needs its reversed ID as a URL scheme in Info.plist)
VITE_GOOGLE_IOS_CLIENT_ID=

# Debug-only switches read by capacitor.config.ts / android build.gradle (NEVER in a release build):
#   CAP_DEV_ALLOW_LAN_HTTP=true   -> http scheme + cleartext for a LAN API (debug APK only)
#   CAP_DEV_WEB_DEBUGGING=true    -> chrome://inspect on the WebView
