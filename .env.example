# API Configuration
# Copy this file to .env and fill in the values for your environment

VITE_API_BASE_URL=http://localhost:3000

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Sentry (error tracking) — OPTIONAL.
# When VITE_SENTRY_DSN is empty/unset, Sentry is fully disabled (no-op): nothing
# is initialized and no events are sent. Set the DSN to enable errors-only tracking.
VITE_SENTRY_DSN=
# Environment tag shown in Sentry. Defaults to "beta" when unset.
VITE_SENTRY_ENVIRONMENT=
