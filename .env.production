# Production configuration
# Fill in with the credentials from the Firebase project "treinoway" (prod)
#
# Empty values here are intentional: the deploy platform (Railway/Vercel)
# dashboard supplies them at build time. A build with an empty
# VITE_API_BASE_URL no longer falls back to localhost — it logs an error and
# reports to Sentry (see src/api/baseUrl.js).

VITE_API_BASE_URL=

# Beta gate — "true" keeps the closed beta ON: users whose /me returns
# betaAccess:false are redirected to /invite instead of hitting a raw 403 on
# PATCH /become-trainer. Must mirror the backend gate.
VITE_BETA_GATE_ENABLED=true

# Firebase (Production)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Sentry (error tracking) — OPTIONAL. No-op when VITE_SENTRY_DSN is empty/unset.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=beta
