# Staging configuration — used by `npm run build:staging` (vite build --mode staging).
#
# This file is TRACKED in git so a fresh clone / CI build resolves every VITE_
# key instead of silently building with none of them (.env and .env.local are
# gitignored and only exist on developer machines).
#
# Values left empty MUST be supplied by the deploy platform's environment
# variable dashboard at build time — do not commit real secrets here.
# Staging mirrors production on purpose so the invite flow is actually
# exercised before it reaches prod.

# HUMAN TODO: staging API origin (e.g. https://<staging-service>.up.railway.app).
# Empty in a staging build => console.error + Sentry event, never localhost.
VITE_API_BASE_URL=

# Beta gate — mirrors production so the /invite redirect is tested in staging.
VITE_BETA_GATE_ENABLED=true

# Firebase (staging project) — HUMAN TODO: fill from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Sentry (error tracking) — OPTIONAL. No-op when VITE_SENTRY_DSN is empty/unset.
# HUMAN TODO: set the DSN if staging errors should be tracked.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
